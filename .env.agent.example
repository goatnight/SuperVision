SPINEVISION_ARTIFACT_ROOT=agent_artifacts
SPINEVISION_SEGMENTATION_PROJECT=train_test
SPINEVISION_SEGMENTATION_CHECKPOINT=runslite_256/best.pt
SPINEVISION_SEGMENTATION_DEVICE=auto
SPINEVISION_CLASSIFIER_BACKEND=mock
# To enable the real ROI classifier, provide private/local model artifacts:
# SPINEVISION_CLASSIFIER_BACKEND=roi_case
# SPINEVISION_CLASSIFIER_PROJECT_ROOT=remote_training/spine_roi_case_cls
# SPINEVISION_CLASSIFIER_CHECKPOINT=remote_training/spine_roi_case_cls/runs/best.pt
SPINEVISION_CLASSIFIER_DEVICE=auto
# SPINEVISION_CLINICAL_POLICY=remote_training/spine_roi_case_cls/runs/clinical_policy.json
# Optional custom backend instead of the built-in ROI case classifier:
# SPINEVISION_CLASSIFIER_BACKEND=callable
# SPINEVISION_CLASSIFIER_ROOT=C:\path\to\classification-project
# SPINEVISION_CLASSIFIER_CALLABLE=my_inference_bridge:predict_case
SPINEVISION_KNOWLEDGE_DB=agent_artifacts/knowledge.sqlite3
SPINEVISION_CONFIDENCE_THRESHOLD=0.70
